{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":separateMultipleMajorReleases",
    "security:openssf-scorecard"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["* * * * 6"],
  "dependencyDashboard": {
    "autoclose": true
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "1 day"
  },
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * 6"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "actionlint and zizmor, installed with pipx in the Lint workflow.",
      "managerFilePatterns": ["/^\\.github/workflows/lint\\.yml$/"],
      "matchStrings": ["pipx install (?<depName>[a-z0-9-]+)==(?<currentValue>[0-9.]+)"],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["npm", "github-actions", "pypi"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": ["@typespec/**"],
      "groupName": "typespec"
    },
    {
      "description": "The override pins the last @napi-rs/wasm-runtime the oxc wasm bindings load with in the browser (see pnpm-workspace.yaml); a newer one stops the playground generating.",
      "matchDepNames": ["/@napi-rs\\/wasm-runtime$/"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["pin", "pinDigest"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "automerge": false
    }
  ]
}
