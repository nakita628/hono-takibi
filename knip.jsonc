{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Knip finds unused files, dependencies and exports (`pnpm knip`, also part of `pnpm lint`).
  // Everything below is something the import graph cannot see: a file a CLI reads by name, a
  // package that only source text written at runtime imports. An entry here needs its reason
  // beside it; code that is simply unused is deleted instead.
  "workspaces": {
    ".": {},
    "packages/hono-takibi": {
      "ignore": [
        // Test code generation is deprecated; the implementation is kept commented out for
        // reference, so these modules are imported by nothing on purpose.
        "src/core/test/index.ts",
        "src/generator/test/**",
      ],
      "ignoreDependencies": [
        // Imported by the code the generators emit and by TypeSpec documents the suite writes
        // to disk and runs: the specifiers are in strings, the packages must be installed.
        "@faker-js/faker",
        "@hono/zod-openapi",
        "@typespec/rest",
        "hono",
        // The provider `test.coverage` in vite.config.ts would load. Coverage is not run by any
        // script, so it is not installed.
        "@vitest/coverage-v8",
      ],
    },
    "test": {
      "entry": [
        // Read by the hono-takibi CLI (scripts/generate.mjs), one per case.
        "**/hono-takibi.config.ts",
        // Compiled by `tsc -p cases/<name>` through each case's tsconfig `include`.
        "cases/split/consumer.ts",
        "types/*.ts",
      ],
      "ignore": [
        // Copy templates completed inside __generated__/<case> after generation; their
        // imports only resolve there, where the per-case tsc checks them.
        "cases/*/overlay/**",
        // Imports through the `~/*` and `@/*` aliases of its tsconfig, which point into
        // __generated__ (gitignored): they resolve only once the suite has generated, and
        // knip runs before that in the Lint workflow.
        "cases/split-alias/consumer.ts",
      ],
      "ignoreDependencies": [
        // Imported by generated mock servers and by the TypeSpec documents under specs/.
        "@faker-js/faker",
        "@typespec/http",
        "@typespec/openapi",
      ],
      "ignoreIssues": {
        // A small assertion vocabulary: the fixtures use what they need of it.
        "types/assert.ts": ["types"],
        // `AppType` is how a Hono app is handed to an RPC client; the hosts export it as an
        // app does, whether or not a test reads it.
        "hosts/*.ts": ["types"],
      },
    },
    "website": {
      "ignoreDependencies": [
        // The browser builds of oxc-parser / oxc-transform import these bindings without
        // listing them (see pnpm-workspace.yaml).
        "@oxc-parser/binding-wasm32-wasip1",
        "@oxc-transform/binding-wasm32-wasip1",
        // Bundled into the playground by name (.vitepress/lib/typespec/index.ts).
        "@typespec/rest",
        "@typespec/xml",
      ],
    },
    "apps/nakita628-fizz-buzz": {
      "entry": [
        // The Worker's entrypoint, as cloudflare.config.ts names it.
        "src/index.ts",
        // Read by the `cf` and `hono-takibi` CLIs.
        "cloudflare.config.ts",
        "hono-takibi.config.ts",
      ],
      "ignoreDependencies": [
        // Imported by main.tsp.
        "@typespec/http",
        "@typespec/openapi",
        "@typespec/openapi3",
        // The types `cf build` writes to .cloudflare/ (gitignored) import `wrangler`.
        "wrangler",
      ],
      "ignoreIssues": {
        // Generated by hono-takibi with `exportSchemas: true`.
        "src/routes/index.ts": ["exports"],
      },
    },
  },
}
