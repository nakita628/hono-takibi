{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hono-takibi-website",
  "compatibility_date": "2026-06-11",
  "assets": {
    "directory": "./.vitepress/dist",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "hono-takibi.dev",
      "custom_domain": true,
    },
  ],
}
